# Copy to .env, or run `npm run wp:up` to have it filled in for the local Docker WordPress.
PORT=3000
WP_URL=http://localhost:8080
WP_USER=admin
# wp-admin > Users > Profile > Application Passwords
WP_APP_PASSWORD=
# Port for the local Docker WordPress (docker-compose.yml)
WP_PORT=8080
# Local AI model for copywriting (npm run ai:up). Nothing is sent online.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
